POSTGRES_DB=crowd_management
POSTGRES_USER=crowd_user
POSTGRES_PASSWORD=crowd_password

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MINUTES=1440

CORS_ALLOWED_ORIGINS=http://localhost:3000
REACT_APP_API_BASE=http://localhost:8080/api
REACT_APP_WS_URL=http://localhost:8080/ws

# Redis caching (used automatically by `docker compose up`; only needed if
# running the backend outside Docker without a local Redis server)
REDIS_HOST=localhost
REDIS_PORT=6379
# Set CACHE_TYPE=simple to use in-memory caching instead of Redis when
# running `mvn spring-boot:run` locally without Docker/Redis installed.
CACHE_TYPE=redis
